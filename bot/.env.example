# Скопируйте в .env или задайте эти переменные окружения перед запуском бота.
# Токен бота — получите у @BotFather в Telegram.
BOT_TOKEN=123456789:AAA...your...token...

# Telegram ID администраторов через запятую (узнать свой ID: /id после запуска,
# либо бот @userinfobot). Можно оставить пустым и выдать доступ по паролю.
ADMIN_IDS=

# Пароль первого входа: администратор отправляет боту /start <пароль>,
# его ID сохраняется в bot/admins.json и пароль больше не нужен.
ADMIN_PASSWORD=

# Автоматически выполнять git push после каждого изменения (1/0).
AUTO_PUSH=1

# Необязательные: имя и почта для git-коммитов от имени бота.
# BOT_GIT_NAME=poetry-site-bot
# BOT_GIT_EMAIL=bot@poetry-site.local

# Необязательные: путь к репозиторию сайта (по умолчанию — родитель папки bot/).
# REPO_DIR=/path/to/poetry_site
